{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamic-unity.local/specs/phenomenon-capability-atlas-v0.1.schema.json",
  "title": "Dynamic Unity Phenomenon-to-Capability Atlas v0.1",
  "description": "A source-sovereign bundle of immutable source bindings and receiver-owned phenomenon/capability overlays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "atlas_id",
    "status",
    "owner",
    "created_at",
    "routing",
    "denominator",
    "evidence_ceiling",
    "source_adapters",
    "source_bindings",
    "phenomena",
    "cross_specimen_controls",
    "nonclaims"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "atlas_id": { "const": "DU-PCA-PILOT-0.1" },
    "status": { "const": "COMPLETED_NONROUTING_METHOD_PILOT" },
    "owner": { "const": "dynamic-unity" },
    "created_at": { "type": "string", "format": "date" },
    "routing": { "$ref": "#/$defs/routing" },
    "denominator": { "$ref": "#/$defs/denominator" },
    "evidence_ceiling": { "const": 2 },
    "source_adapters": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/sourceAdapter" }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/sourceBinding" }
    },
    "phenomena": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/phenomenon" }
    },
    "cross_specimen_controls": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/crossControl" }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 10 }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_routing",
        "banked",
        "wip",
        "live_authority",
        "scheduled_priority_unchanged",
        "executable_continuation"
      ],
      "properties": {
        "non_routing": { "const": true },
        "banked": { "const": false },
        "wip": { "const": false },
        "live_authority": { "const": "CURRENT-RESEARCH.yaml" },
        "scheduled_priority_unchanged": { "const": true },
        "executable_continuation": { "type": "null" }
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "count",
        "exhaustive",
        "inclusion_rule",
        "exclusion_rule",
        "freeze_rule"
      ],
      "properties": {
        "kind": { "const": "BOUNDED_STRESS_SET" },
        "count": { "const": 6 },
        "exhaustive": { "const": false },
        "inclusion_rule": { "$ref": "#/$defs/nonEmptyString" },
        "exclusion_rule": { "$ref": "#/$defs/nonEmptyString" },
        "freeze_rule": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "sourceAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "source_repo",
        "revision",
        "source_kind",
        "role",
        "authority_transfer",
        "truth_boundary",
        "phenomenon_eligible"
      ],
      "properties": {
        "adapter_id": { "type": "string", "pattern": "^ADAPTER-[A-Z0-9-]+$" },
        "source_repo": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_kind": {
          "enum": [
            "THEORY_REQUIREMENT_LEDGER",
            "PHYSICS_RESULT",
            "CAPABILITY_METHOD",
            "TRANSITION_DIAGNOSTIC",
            "ISSUANCE_EFFECT_METHOD",
            "RECORD_PROVENANCE_METHOD"
          ]
        },
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "authority_transfer": { "const": false },
        "truth_boundary": { "$ref": "#/$defs/nonEmptyString" },
        "phenomenon_eligible": { "type": "boolean" }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "adapter_ref",
        "source_owner",
        "immutable_revision",
        "artifact_locator",
        "assertion_selector",
        "content_sha256",
        "native_claim_status",
        "native_evidence_grade",
        "receiver_paraphrase",
        "source_nonclaims",
        "missing_import_requirements"
      ],
      "properties": {
        "binding_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
        "adapter_ref": { "type": "string", "pattern": "^ADAPTER-[A-Z0-9-]+$" },
        "source_owner": { "$ref": "#/$defs/nonEmptyString" },
        "immutable_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_locator": { "$ref": "#/$defs/nonEmptyString" },
        "assertion_selector": { "$ref": "#/$defs/nonEmptyString" },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "native_claim_status": { "$ref": "#/$defs/nonEmptyString" },
        "native_evidence_grade": { "$ref": "#/$defs/nonEmptyString" },
        "receiver_paraphrase": { "$ref": "#/$defs/nonEmptyString" },
        "source_nonclaims": { "$ref": "#/$defs/nonEmptyStringList" },
        "missing_import_requirements": { "$ref": "#/$defs/stringList" }
      }
    },
    "phenomenon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phenomenon_id",
        "display_name",
        "domain",
        "lifecycle",
        "source_binding_refs",
        "source_grounding_status",
        "physics",
        "process",
        "record_ladder",
        "observer_profiles",
        "task_family",
        "contrasts",
        "projection_audit",
        "finality",
        "temporal_issuance",
        "structures",
        "evidence"
      ],
      "properties": {
        "phenomenon_id": { "type": "string", "pattern": "^DU-PCA-[0-9]{3}$" },
        "display_name": { "$ref": "#/$defs/nonEmptyString" },
        "domain": { "$ref": "#/$defs/nonEmptyString" },
        "lifecycle": { "const": "REVIEWED" },
        "source_binding_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" }
        },
        "source_grounding_status": {
          "enum": ["AUDITED_LOCAL_PACKET", "PRIMARY_AUDIT_REQUIRED"]
        },
        "physics": { "$ref": "#/$defs/physics" },
        "process": { "$ref": "#/$defs/process" },
        "record_ladder": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/recordStage" }
        },
        "observer_profiles": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/observer" }
        },
        "task_family": { "$ref": "#/$defs/taskFamily" },
        "contrasts": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/contrast" }
        },
        "projection_audit": { "$ref": "#/$defs/projectionAudit" },
        "finality": { "$ref": "#/$defs/finality" },
        "temporal_issuance": { "$ref": "#/$defs/temporalIssuance" },
        "structures": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/structure" }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "empirical_signature",
        "accepted_frameworks",
        "governing_relations",
        "validity_regime",
        "observables",
        "source_assertion_refs",
        "completeness_status"
      ],
      "properties": {
        "empirical_signature": { "$ref": "#/$defs/nonEmptyString" },
        "accepted_frameworks": { "$ref": "#/$defs/nonEmptyStringList" },
        "governing_relations": { "$ref": "#/$defs/nonEmptyStringList" },
        "validity_regime": { "$ref": "#/$defs/nonEmptyString" },
        "observables": { "$ref": "#/$defs/nonEmptyStringList" },
        "source_assertion_refs": { "$ref": "#/$defs/nonEmptyStringList" },
        "completeness_status": {
          "enum": ["SCOPED_ACCEPTED_DESCRIPTION", "SCOPED_MODEL_WITH_AUDIT_GAP"]
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "antecedents",
        "transitions",
        "interventions",
        "temporal_antecedents",
        "geometric_antecedents"
      ],
      "properties": {
        "direction": { "const": "SOURCE_PHYSICS_TO_INDUCED_CAPABILITY" },
        "antecedents": { "$ref": "#/$defs/nonEmptyStringList" },
        "transitions": { "$ref": "#/$defs/nonEmptyStringList" },
        "interventions": { "$ref": "#/$defs/nonEmptyStringList" },
        "temporal_antecedents": { "$ref": "#/$defs/nonEmptyStringList" },
        "geometric_antecedents": { "$ref": "#/$defs/nonEmptyStringList" }
      }
    },
    "recordStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "target", "carrier", "condition", "warrant"],
      "properties": {
        "level": {
          "enum": [
            "EVENT",
            "TRACE",
            "RETAINED_RECORD",
            "ACCESSIBLE_RECORD",
            "CERTIFICATE",
            "PUBLIC_FINAL_RECORD",
            "ACTION_ENABLING_FACT"
          ]
        },
        "status": {
          "enum": ["ESTABLISHED", "CONDITIONAL", "FAILED", "UNKNOWN", "NOT_APPLICABLE"]
        },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "carrier": { "$ref": "#/$defs/nonEmptyString" },
        "condition": { "$ref": "#/$defs/nonEmptyString" },
        "warrant": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_id",
        "observer_kind",
        "physical_subsystem",
        "boundary",
        "channels",
        "visible_records",
        "horizon",
        "operations",
        "resources",
        "risk_or_error",
        "provenance"
      ],
      "properties": {
        "observer_id": { "type": "string", "pattern": "^OBS-[A-Z0-9-]+$" },
        "observer_kind": {
          "enum": [
            "DETECTOR_SUBSYSTEM",
            "LOCAL_CONTROLLER",
            "LABORATORY_AGENT",
            "DISTRIBUTED_OBSERVER",
            "EXTERIOR_CAUSAL_OBSERVER",
            "INFALLING_OBSERVER"
          ]
        },
        "physical_subsystem": { "$ref": "#/$defs/nonEmptyString" },
        "boundary": { "$ref": "#/$defs/nonEmptyString" },
        "channels": { "$ref": "#/$defs/nonEmptyStringList" },
        "visible_records": { "$ref": "#/$defs/stringList" },
        "horizon": { "$ref": "#/$defs/nonEmptyString" },
        "operations": { "$ref": "#/$defs/nonEmptyStringList" },
        "resources": { "$ref": "#/$defs/nonEmptyStringList" },
        "risk_or_error": { "$ref": "#/$defs/nonEmptyString" },
        "provenance": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "taskFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task",
        "success_rule",
        "horizon",
        "actions",
        "resources",
        "risk_or_error",
        "provenance_requirement"
      ],
      "properties": {
        "task_id": { "type": "string", "pattern": "^TASK-[A-Z0-9-]+$" },
        "task": { "$ref": "#/$defs/nonEmptyString" },
        "success_rule": { "$ref": "#/$defs/nonEmptyString" },
        "horizon": { "$ref": "#/$defs/nonEmptyString" },
        "actions": { "$ref": "#/$defs/nonEmptyStringList" },
        "resources": { "$ref": "#/$defs/nonEmptyStringList" },
        "risk_or_error": { "$ref": "#/$defs/nonEmptyString" },
        "provenance_requirement": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrast_id",
        "left",
        "right",
        "is_matched_control",
        "comparison_frame",
        "witness",
        "expected_diagnosis"
      ],
      "properties": {
        "contrast_id": { "type": "string", "pattern": "^X-[A-Z0-9-]+$" },
        "left": { "$ref": "#/$defs/nonEmptyString" },
        "right": { "$ref": "#/$defs/nonEmptyString" },
        "is_matched_control": { "type": "boolean" },
        "comparison_frame": { "$ref": "#/$defs/comparisonFrame" },
        "witness": { "$ref": "#/$defs/p2cWitness" },
        "expected_diagnosis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "POSSIBILITY_FAMILY_CHANGE",
              "FIXED_FAMILY_DYNAMICS_CHANGE",
              "RECORD_FORMATION",
              "ACCESS_CHANGE",
              "CAPABILITY_ENLARGEMENT",
              "CAPABILITY_RESTRICTION",
              "FINALITY_CANDIDATE",
              "NO_CAPABILITY_CHANGE"
            ]
          }
        }
      }
    },
    "comparisonFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched_fields", "changed_fields", "unmatched_fields", "normalization"],
      "properties": {
        "matched_fields": { "$ref": "#/$defs/nonEmptyStringList" },
        "changed_fields": { "$ref": "#/$defs/nonEmptyStringList" },
        "unmatched_fields": { "$ref": "#/$defs/stringList" },
        "normalization": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "p2cWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "possibility_family_relation",
        "representation_relation",
        "description_change",
        "dynamics_change",
        "persistent_record",
        "access_change",
        "control_change",
        "irreversible",
        "settlement",
        "raw_task_relation",
        "normalized_task_relation",
        "preceding_factorization",
        "factorization_search_scope",
        "ordering",
        "reopenable_by_admissible_continuation"
      ],
      "properties": {
        "possibility_family_relation": {
          "enum": ["SAME", "DIFFERENT", "INCOMPARABLE", "UNKNOWN", "CONTESTED"]
        },
        "representation_relation": {
          "enum": ["EQUIVALENT", "INEQUIVALENT", "UNKNOWN", "CONTESTED"]
        },
        "description_change": { "$ref": "#/$defs/yesNo" },
        "dynamics_change": { "$ref": "#/$defs/yesNo" },
        "persistent_record": { "$ref": "#/$defs/yesNo" },
        "access_change": { "$ref": "#/$defs/yesNo" },
        "control_change": { "$ref": "#/$defs/yesNo" },
        "irreversible": { "$ref": "#/$defs/yesNo" },
        "settlement": { "$ref": "#/$defs/yesNo" },
        "raw_task_relation": { "$ref": "#/$defs/taskRelation" },
        "normalized_task_relation": { "$ref": "#/$defs/taskRelation" },
        "preceding_factorization": {
          "enum": ["FACTORED", "NO_FACTOR_FOUND", "NOT_APPLICABLE", "UNKNOWN", "CONTESTED"]
        },
        "factorization_search_scope": { "$ref": "#/$defs/nonEmptyString" },
        "ordering": {
          "enum": [
            "ORDER_COMPATIBLE",
            "CO_OCCURRENT",
            "INCOMPARABLE",
            "CYCLIC",
            "UNREPRESENTABLE",
            "UNKNOWN",
            "CONTESTED"
          ]
        },
        "reopenable_by_admissible_continuation": { "$ref": "#/$defs/yesNo" }
      }
    },
    "yesNo": { "enum": ["YES", "NO", "UNKNOWN", "CONTESTED"] },
    "taskRelation": {
      "enum": ["EQUAL", "SUPERSET", "SUBSET", "INCOMPARABLE", "UNKNOWN", "CONTESTED"]
    },
    "projectionAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "visible_equivalence",
        "sufficiency_status",
        "witness_pair",
        "capability_spread",
        "native_comparison"
      ],
      "properties": {
        "projection": { "$ref": "#/$defs/nonEmptyString" },
        "visible_equivalence": { "$ref": "#/$defs/nonEmptyString" },
        "sufficiency_status": {
          "enum": ["CONSTANT_ON_FIBRES", "VARIES_ON_FIBRES", "NOT_TESTED", "NOT_APPLICABLE"]
        },
        "witness_pair": { "$ref": "#/$defs/nonEmptyString" },
        "capability_spread": { "$ref": "#/$defs/nonEmptyString" },
        "native_comparison": {
          "enum": ["EQUIVALENCE", "PREORDER", "PARETO_DOMINANCE", "METRIC_BOUND", "RISK_BOUND"]
        }
      }
    },
    "finality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_scope",
        "public_scope",
        "global_scope",
        "settlement",
        "preceding_factorization",
        "factorization_search_scope",
        "reopenable_by_admissible_continuation",
        "reopener",
        "verdict"
      ],
      "properties": {
        "local_scope": { "$ref": "#/$defs/nonEmptyString" },
        "public_scope": { "$ref": "#/$defs/nonEmptyString" },
        "global_scope": { "$ref": "#/$defs/nonEmptyString" },
        "settlement": { "$ref": "#/$defs/yesNo" },
        "preceding_factorization": {
          "enum": ["FACTORED", "NO_FACTOR_FOUND", "NOT_APPLICABLE", "UNKNOWN", "CONTESTED"]
        },
        "factorization_search_scope": { "$ref": "#/$defs/nonEmptyString" },
        "reopenable_by_admissible_continuation": { "$ref": "#/$defs/yesNo" },
        "reopener": { "$ref": "#/$defs/nonEmptyString" },
        "verdict": { "enum": ["NONE", "LOCAL_ONLY", "PUBLIC_CANDIDATE", "GLOBAL_CANDIDATE"] }
      }
    },
    "temporalIssuance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "source_side_primitive",
        "same_neighbor_data_discriminator",
        "ordinary_disclosure_absorber",
        "warrant"
      ],
      "properties": {
        "classification": { "enum": ["ISSUANCE", "DISCLOSURE", "UNDECIDED", "NOT_APPLICABLE"] },
        "source_side_primitive": { "type": "boolean" },
        "same_neighbor_data_discriminator": { "type": "boolean" },
        "ordinary_disclosure_absorber": { "$ref": "#/$defs/nonEmptyString" },
        "warrant": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure_id",
        "kind",
        "origin",
        "warrant",
        "carrier",
        "maps_or_relations",
        "invariant",
        "axioms_checked",
        "evidence_ceiling"
      ],
      "properties": {
        "structure_id": { "type": "string", "pattern": "^G-[A-Z0-9-]+$" },
        "kind": {
          "enum": [
            "STATE_SPACE",
            "CAUSAL_PARTIAL_ORDER",
            "FIBRE_FAMILY",
            "QUOTIENT",
            "INTERACTION_GRAPH",
            "HYPERGRAPH",
            "MATCHING_COMPLEX",
            "RESOURCE_PREORDER",
            "STRATIFIED_SPACE",
            "HOMOTOPY_CLASS",
            "LORENTZIAN_GEOMETRY",
            "STOCHASTIC_CHAIN"
          ]
        },
        "origin": { "enum": ["SOURCE_THEORY", "ATLAS_INTRODUCED"] },
        "warrant": {
          "enum": ["PHYSICS_OWNED", "FAITHFUL_REPRESENTATION", "STRUCTURAL_ANALOGY", "OPEN", "NOT_APPLICABLE"]
        },
        "carrier": { "$ref": "#/$defs/nonEmptyString" },
        "maps_or_relations": { "$ref": "#/$defs/nonEmptyString" },
        "invariant": { "$ref": "#/$defs/nonEmptyString" },
        "axioms_checked": { "$ref": "#/$defs/nonEmptyStringList" },
        "evidence_ceiling": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atlas_grade",
        "ceiling_reason",
        "strongest_absorber",
        "cheapest_kill",
        "falsifier",
        "missing_work",
        "nonclaims"
      ],
      "properties": {
        "atlas_grade": { "type": "integer", "minimum": 0, "maximum": 2 },
        "ceiling_reason": { "$ref": "#/$defs/nonEmptyString" },
        "strongest_absorber": { "$ref": "#/$defs/nonEmptyString" },
        "cheapest_kill": { "$ref": "#/$defs/nonEmptyString" },
        "falsifier": { "$ref": "#/$defs/nonEmptyString" },
        "missing_work": { "$ref": "#/$defs/nonEmptyStringList" },
        "nonclaims": { "$ref": "#/$defs/nonEmptyStringList" }
      }
    },
    "crossControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "mutation", "must_reject_because"],
      "properties": {
        "control_id": { "type": "string", "pattern": "^CTRL-[0-9]{2}$" },
        "mutation": { "$ref": "#/$defs/nonEmptyString" },
        "must_reject_because": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
