{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CURRENT-RESEARCH.schema.json",
  "title": "Dynamic Unity current research authority",
  "description": "Structural contract only. Scientific meaning, grades, and routing invariants are checked by tests/du_agent_orientation_contract_probe.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current_research_contract_version",
    "schema_ref",
    "state_revision",
    "as_of",
    "authority",
    "scope",
    "non_authorities",
    "rules",
    "status_enums",
    "run_home_contract",
    "transition_protocol",
    "current_decision",
    "programs",
    "successor_selection",
    "anomaly_intake"
  ],
  "properties": {
    "current_research_contract_version": {
      "const": "1.2"
    },
    "schema_ref": {
      "const": "CURRENT-RESEARCH.schema.json"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "authority": {
      "$ref": "#/$defs/nonemptyString"
    },
    "scope": {
      "$ref": "#/$defs/nonemptyString"
    },
    "non_authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientific_flagship_wip_limit",
        "bounded_side_probe_wip_limit",
        "publication_wip_limit",
        "sole_executable_action_required",
        "publication_consumes_banked_science_only",
        "paper_readiness_never_promotes_scientific_grade",
        "historical_snapshots_never_route_current_work",
        "parked_work_requires_reopen_rule",
        "successor_is_selected_after_current_flagship",
        "anomaly_intake_is_not_a_standing_lane",
        "quiescent_no_ready_allowed"
      ],
      "properties": {
        "scientific_flagship_wip_limit": {
          "type": "integer",
          "minimum": 0
        },
        "bounded_side_probe_wip_limit": {
          "type": "integer",
          "minimum": 0
        },
        "publication_wip_limit": {
          "type": "integer",
          "minimum": 0
        },
        "sole_executable_action_required": {
          "type": "boolean"
        },
        "publication_consumes_banked_science_only": {
          "type": "boolean"
        },
        "paper_readiness_never_promotes_scientific_grade": {
          "type": "boolean"
        },
        "historical_snapshots_never_route_current_work": {
          "type": "boolean"
        },
        "parked_work_requires_reopen_rule": {
          "type": "boolean"
        },
        "successor_is_selected_after_current_flagship": {
          "type": "boolean"
        },
        "anomaly_intake_is_not_a_standing_lane": {
          "type": "boolean"
        },
        "quiescent_no_ready_allowed": {
          "type": "boolean"
        }
      }
    },
    "status_enums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_status",
        "execution_status",
        "dependency_type",
        "dependency_target_type"
      ],
      "properties": {
        "portfolio_status": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "execution_status": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "dependency_type": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "dependency_target_type": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      }
    },
    "run_home_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governed_run_home",
        "legacy_run_home",
        "rule"
      ],
      "properties": {
        "governed_run_home": {
          "const": "lab/process/runs/"
        },
        "legacy_run_home": {
          "const": "runs/"
        },
        "rule": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "transition_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "history_rule"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "history_rule": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "current_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_scientific_program_id",
        "executable_action_id",
        "prepared_publication_program_id",
        "selected_successor_id",
        "decision_note"
      ],
      "properties": {
        "active_scientific_program_id": {
          "$ref": "#/$defs/nullableString"
        },
        "executable_action_id": {
          "$ref": "#/$defs/nullableString"
        },
        "prepared_publication_program_id": {
          "$ref": "#/$defs/nullableString"
        },
        "selected_successor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_note": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "successor_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocked_by",
        "selected_successor_id",
        "candidate_classes",
        "decision_rule"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/nonemptyString"
        },
        "blocked_by": {
          "$ref": "#/$defs/nullableString"
        },
        "selected_successor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "decision_rule": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "anomaly_intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "destination_refs",
        "activation_rule"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/nonemptyString"
        },
        "destination_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "activation_rule": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "grade": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 5
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target",
        "target_type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonemptyString"
        },
        "target": {
          "$ref": "#/$defs/nonemptyString"
        },
        "target_type": {
          "$ref": "#/$defs/nonemptyString"
        },
        "owner_repo": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "completedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evidence_ref": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonemptyString"
        },
        "role": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "executionPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "exact_question",
        "source_locator",
        "required_inputs",
        "unchanged_ledger_fields",
        "arena_roles",
        "expected_return_classes",
        "observer_index_return_classes",
        "durable_output",
        "local_method",
        "uses_program_controls"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "exact_question": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source_locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "heading"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/nonemptyString"
            },
            "heading": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        "required_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputReference"
          }
        },
        "unchanged_ledger_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "arena_roles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "expected_return_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "observer_index_return_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "durable_output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "local_method": {
          "$ref": "#/$defs/nonemptyString"
        },
        "uses_program_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "owner_repo",
        "portfolio_status",
        "execution_status",
        "wip_slot",
        "primary_lane_id",
        "supporting_lane_ids",
        "channel_ids",
        "target",
        "current_grade",
        "evidence_grade",
        "maximum_grade",
        "maximum_evidence_grade",
        "premise_status",
        "completed_dependencies",
        "remaining_obligations",
        "typed_dependencies",
        "cheapest_kill",
        "stop_rule",
        "reopen_rule",
        "local_computation_boundary",
        "next_action",
        "next_action_ref",
        "canonical_evidence_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "$ref": "#/$defs/nonemptyString"
        },
        "owner_repo": {
          "$ref": "#/$defs/nonemptyString"
        },
        "portfolio_status": {
          "$ref": "#/$defs/nonemptyString"
        },
        "execution_status": {
          "$ref": "#/$defs/nonemptyString"
        },
        "wip_slot": {
          "$ref": "#/$defs/nonemptyString"
        },
        "active_work_id": {
          "$ref": "#/$defs/nullableString"
        },
        "candidate_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "primary_lane_id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "supporting_lane_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "channel_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "target": {
          "$ref": "#/$defs/nonemptyString"
        },
        "current_grade": {
          "$ref": "#/$defs/nonemptyString"
        },
        "evidence_grade": {
          "$ref": "#/$defs/grade"
        },
        "maximum_grade": {
          "$ref": "#/$defs/nonemptyString"
        },
        "maximum_evidence_grade": {
          "$ref": "#/$defs/grade"
        },
        "premise_status": {
          "$ref": "#/$defs/nonemptyString"
        },
        "completed_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/completedDependency"
          }
        },
        "remaining_obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "typed_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "strongest_absorber": {
          "$ref": "#/$defs/nonemptyString"
        },
        "cheapest_kill": {
          "$ref": "#/$defs/nonemptyString"
        },
        "stop_rule": {
          "$ref": "#/$defs/nonemptyString"
        },
        "reopen_rule": {
          "$ref": "#/$defs/nonemptyString"
        },
        "local_computation_boundary": {
          "$ref": "#/$defs/nonemptyString"
        },
        "next_action": {
          "$ref": "#/$defs/nullableString"
        },
        "next_action_ref": {
          "$ref": "#/$defs/nullableString"
        },
        "execution_packet": {
          "$ref": "#/$defs/executionPacket"
        },
        "canonical_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      }
    }
  }
}
